# --- Claude (required for extraction + chat; the table and seed work without it) ---
# Create a key at https://console.anthropic.com -> Settings -> API Keys (pay-as-you-go credits; separate from a Claude Max subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Database ---
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" URI, then change the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty to use a local SQLite file (backend/invoices.db) — handy for offline development.
DATABASE_URL=

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# --- Frontend (Vite exposes only VITE_* keys to the browser) -----------------
VITE_API_URL=http://127.0.0.1:8000
# true serves frontend/src/api/mock.ts fixtures instead of calling the backend
VITE_USE_MOCK=false
