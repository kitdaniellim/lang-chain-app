# --- LLM provider -----------------------------------------------------------
# fake      = deterministic rule-based model (default; works offline, used by tests)
# anthropic = real Claude via @langchain/anthropic
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Fault injection for the fake model (demonstrates retries / fallbacks)
FAKE_FAILURE_RATE=0
FAKE_LATENCY_MS=0

# Resilience
LLM_MAX_RETRIES=3
PIPELINE_CONCURRENCY=4

# --- Persistence ------------------------------------------------------------
OUT_DIR=out
CHECKPOINTER=memory          # memory | sqlite (sqlite enables `resume` across processes)

# --- Email sink (optional) --------------------------------------------------
# No SMTP settings => an Ethereal test inbox is created automatically and a
# preview URL is printed. Resend works via SMTP: host smtp.resend.com, user "resend",
# pass = your Resend API key.
EMAIL_TO=
EMAIL_FROM=ap-bot@lang-chain-app.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- LangSmith tracing (optional) ------------------------------------------
# The app never reads these: loadConfig only puts them in process.env, where
# LangChain's own tracer picks them up. Set LANGSMITH_TRACING=true and a key to trace.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lang-chain-app
